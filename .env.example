BIND_ADDRESS=127.0.0.1
BACCHUS_PORT=8092
# The first system administrator (creates and deletes tenants on screen), e.g.
# '{"random-token":{"name":"Operator","role":"system_admin"}}'
# Other roles here (tenant_admin, member) join the default tenant; manage them on screen instead.
# Generate: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
BACCHUS_USERS='{}'
# Public HTTPS URL of this server; required for SSO (redirect URI = this + /api/auth/sso/callback).
BACCHUS_PUBLIC_URL=
# Set to 1 behind a reverse proxy so audit logs record the client IP from X-Forwarded-For.
BACCHUS_TRUST_PROXY=
# Idle hours before a sign-in session ends (default 12, at most 30 days in total).
BACCHUS_SESSION_HOURS=
# AI keys below serve only the default tenant migrated from earlier versions; tenant administrators set keys on screen.
GEMINI_API_KEY=
# Set a currently available image-input model for your Google account.
GEMINI_MODEL=
# Optional: gemini (default), claude or openai. A service saved on the web settings screen wins.
AI_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
