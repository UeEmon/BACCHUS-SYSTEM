BIND_ADDRESS=127.0.0.1
BACCHUS_PORT=8092
# A JSON mapping from random tokens (24+ characters) to users, e.g.
# '{"token-1":{"name":"Alice","role":"admin"},"token-2":{"name":"Bob","role":"member"}}'
# Only admins change AI settings. A bare name ("token":"Alice") is an admin; an object without role is a member.
# Generate: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
BACCHUS_USERS='{}'
GEMINI_API_KEY=
# Set a currently available image-input model for your Google account.
GEMINI_MODEL=
# Optional: gemini (default), claude or openai. A service saved on the web settings screen wins.
AI_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
